<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<LangVersion>13</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>$(AssemblyName)</Title>
		<Authors>LIN Platform</Authors>
		<Version>2026.11.12</Version>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Global.Http" Version="4.1.0" />
		<PackageReference Include="LIN.Types.Cloud.Identity.Platform" Version="1.9.0" />
		<PackageReference Include="LIN.Types.Developer" Version="4.3.0" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
	</ItemGroup>
</Project>




